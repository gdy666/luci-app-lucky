#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT

START=99
STOP=15
USE_PROCD=1

PROG=/usr/bin/lucky
DEFAULT_CONFIG_DIR=/etc/config/lucky.daji

validate_config_dir() {
	local newline
	newline='
'
	case "$1" in
	*"$newline"* | //* | / | /proc | /proc/* | /sys | /sys/* | /dev | /dev/* | /run | /run/* | */../* | */.. | */./* | */.) ;;
	/*) return 0 ;;
	*) ;;
	esac
	logger -t lucky -p daemon.err "Rejected unsafe config directory: $1"
	return 1
}

start_instance() {
	local section="$1"
	local enabled config_dir logger_enabled

	config_get_bool enabled "$section" enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get config_dir "$section" configdir "$DEFAULT_CONFIG_DIR"
	config_get_bool logger_enabled "$section" logger 1
	validate_config_dir "$config_dir" || return 1
	umask 077
	mkdir -p "$config_dir" || return 1

	procd_open_instance "$section"
	procd_set_param command "$PROG" -cd "$config_dir"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	[ "$logger_enabled" -eq 1 ] && procd_set_param stdout 1
	procd_set_param file /etc/config/lucky
	procd_close_instance
}

start_service() {
	config_load lucky
	config_foreach start_instance lucky
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger lucky
}
